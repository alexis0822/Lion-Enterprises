{#- Small reusable pieces: UI icons, solution icons, the logo and section labels. -#}

{%- macro icon(name, cls="") -%}
<svg class="icon{% if cls %} {{ cls }}{% endif %}" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  {%- if name == "arrow" -%}<path d="M4.5 12h14M13 6.5l5.5 5.5-5.5 5.5"/>
  {%- elif name == "arrow-out" -%}<path d="M7 17 17 7M8.5 7H17v8.5"/>
  {%- elif name == "phone" -%}<path d="M6.6 3.5h3.1l1.5 4.1-2.1 1.6c1.1 2.2 2.9 4 5.1 5.1l1.6-2.1 4.1 1.5v3.1c0 1-.8 1.8-1.8 1.8C10.4 18.6 5.4 13.6 4.8 5.3c0-1 .8-1.8 1.8-1.8Z"/>
  {%- elif name == "mail" -%}<path d="M3.5 6h17v12h-17zM3.5 6.5l8.5 6.5 8.5-6.5"/>
  {%- elif name == "pin" -%}<path d="M12 21s-6.5-5.7-6.5-10.6a6.5 6.5 0 0 1 13 0C18.5 15.3 12 21 12 21Z"/><circle cx="12" cy="10.4" r="2.3"/>
  {%- elif name == "clock" -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
  {%- elif name == "menu" -%}<path d="M4 8.5h16M4 15.5h16"/>
  {%- elif name == "close" -%}<path d="M6 6l12 12M18 6 6 18"/>
  {%- elif name == "plus" -%}<path d="M12 5v14M5 12h14"/>
  {%- elif name == "check" -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
  {%- elif name == "copy" -%}<path d="M8.5 8.5h11v11h-11zM15.5 8.5v-4h-11v11h4"/>
  {%- elif name == "info" -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5.5M12 7.4v.6"/>
  {%- elif name == "alert" -%}<path d="M12 4.5l8.5 15h-17zM12 10.5v4M12 16.8v.4"/>
  {%- endif -%}
</svg>
{%- endmacro -%}

{%- macro solutionIcon(name) -%}
<svg class="sicon" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true" focusable="false">
  {%- if name == "techo" -%}
    <path class="sicon__water" d="M17 7l-1.6 5.5M24 5l-1.6 5.5M31 7l-1.6 5.5"/>
    <path d="M6 20h4v10h28V20h4v17H6z"/>
    <path class="sicon__accent" d="M10 21.5V30h28v-8.5"/>
  {%- elif name == "gota" -%}
    <path d="M6 12h36v9H6z"/>
    <path class="sicon__accent" d="M23 12l2.6 3.2-3.2 2.6 2.2 3.2"/>
    <path class="sicon__water" d="M24 27.5c2.3 3.1 3.7 5 3.7 6.9a3.7 3.7 0 0 1-7.4 0c0-1.9 1.4-3.8 3.7-6.9Z"/>
  {%- elif name == "capas" -%}
    <path d="M8 31l16 7 16-7M8 24l16 7 16-7"/>
    <path class="sicon__accent" d="M24 10l16 7-16 7-16-7z"/>
  {%- elif name == "estructura" -%}
    <path d="M13 19h22v19H13zM21 38v-8h6v8M5 38h38"/>
    <path class="sicon__accent" d="M9 38V15h30v23"/>
  {%- elif name == "envase" -%}
    <path d="M14 17c0-6 4-9.5 10-9.5S34 11 34 17"/>
    <path d="M13 17h22l-2.4 21H15.4zM11 17h26"/>
    <path class="sicon__accent" d="M14.2 26h19.6"/>
  {%- elif name == "edificio" -%}
    <path d="M6 40V21M42 40V21M3 40h42M14 40v-9h7v9M27 40v-9h7v9M29 20.5v-6h8v6"/>
    <path class="sicon__accent" d="M6 16.5V21h36v-4.5"/>
  {%- endif -%}
</svg>
{%- endmacro -%}

{#- Official logo. The PNG is a transparent square; the frame crops it to the artwork.
   The link that wraps this already names the business, so the image has an empty alt. -#}
{%- macro logo(site) -%}
<span class="logo__frame">
  <img src="images/lion.png" alt="" width="710" height="710">
</span>
{%- endmacro -%}

{%- macro eyebrow(num, label, id="") -%}
<p class="eyebrow"{% if id %} id="{{ id }}"{% endif %}>
  <span class="eyebrow__num" aria-hidden="true">{{ num }}</span>
  <span class="eyebrow__label">{{ label }}</span>
  <span class="eyebrow__rule" aria-hidden="true"></span>
</p>
{%- endmacro -%}
