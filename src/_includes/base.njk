{%- set pageTitle = title or site.seo.title -%}
{%- set pageDescription = description or site.seo.description -%}
{%- set isHome = page.url == "/" -%}
{#- On the home page links are in-page anchors; elsewhere they point back to the home page. -#}
{%- set home = "" if isHome else "/" -%}
<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {%- if site.url and not noindex %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- endif %}
  <meta name="theme-color" content="#101316">
  <meta name="format-detection" content="telephone=no">

   <link rel="preload" href="{{ '/fonts/archivo-var-latin.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="{{ '/favicon-32.png' | url }}" sizes="32x32" type="image/png">
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_PR">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  {%- if site.url %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ site.seo.ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.seo.ogImageAlt }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">

  <style>{% css %}</style>
  {#- Runs before first paint: marks JavaScript as available and, when animations are wanted and supported, arms the scroll reveals. -#}
  <script>
    (function (root) {
      root.classList.add("js");
      if ("IntersectionObserver" in window && "noModule" in HTMLScriptElement.prototype && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        root.classList.add("reveal-on");
        setTimeout(function () { if (!window.lionReady) root.classList.remove("reveal-on"); }, 4000);
      }
    })(document.documentElement);
  </script>
  {%- if isHome %}
  <script type="application/ld+json">{{ schema | json | safe }}</script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#contenido">{{ copy.a11y.skip }}</a>
  {% include "partials/header.njk" %}
  <main id="contenido" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {%- if isHome %}
  {% include "partials/cta-bar.njk" %}
  {%- endif %}
  <script type="module">{% js %}</script>
</body>
</html>
